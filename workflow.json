    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/objects/2026-03/tickets",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"properties\": {\n    \"hs_pipeline\": \"0\",\n    \"hs_pipeline_stage\": \"1\",\n    \"hs_ticket_priority\": \"HIGH\",\n    \"subject\": \"Offboarding - {{ $('Prepare Offboarding Context').first().json.companyName }}\",\n    \"content\": {{ JSON.stringify($('Prepare Offboarding Context').first().json.ticketDescription) }},\n    \"offboarding_idempotency_key\": \"{{ $('Prepare Offboarding Context').first().json.idempotencyKey }}\"\n  },\n  \"associations\": [\n    {\n      \"to\": {\n        \"id\": \"{{ $('Prepare Offboarding Context').first().json.companyId }}\"\n      },\n      \"types\": [\n        {\n          \"associationCategory\": \"HUBSPOT_DEFINED\",\n          \"associationTypeId\": 26\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1184,
        48
      ],
      "id": "3eb38ff9-42d3-4d3b-a1c0-d67fa3333f1b",
      "name": "Create Offboarding Ticket"
    },
    {
      "parameters": {
        "jsCode": "const input = $json;\n\nconst company = {\n  companyId: input.companyId,\n  companyName: input.properties?.name?.value,\n  customerTier: input.properties?.customer_tier?.value,\n  customerStatus: input.properties?.customer_status?.value,\n  dataExportRequired:\n    input.properties?.data_export_required?.value,\n  financeReviewRequired:\n    input.properties?.finance_review_required?.value,\n  offboardingDate:\n    input.properties?.offboarding_date?.value,\n  offboardingReason:\n    input.properties?.offboarding_reason?.value,\n};\n\nconst requiredCompanyFields = [\n  \"companyId\",\n  \"companyName\",\n  \"customerTier\",\n  \"customerStatus\",\n  \"dataExportRequired\",\n  \"financeReviewRequired\",\n];\n\nconst missingCompanyFields = requiredCompanyFields.filter((field) => {\n  const value = company[field];\n\n  return (\n    value === undefined ||\n    value === null ||\n    value === \"\"\n  );\n});\n\nif (missingCompanyFields.length > 0) {\n  throw new Error(\n    `Missing required fields: ${missingCompanyFields.join(\", \")}`\n  );\n}\n\nfunction normalizeBoolean(value, fieldName) {\n  if (typeof value === \"boolean\") {\n    return value;\n  }\n\n  if (typeof value === \"string\") {\n    const normalizedValue = value.trim().toLowerCase();\n\n    if (normalizedValue === \"true\") return true;\n    if (normalizedValue === \"false\") return false;\n  }\n\n  if (value === 1) return true;\n  if (value === 0) return false;\n\n  throw new Error(\n    `Invalid boolean value for ${fieldName}: ${value}`\n  );\n}\n\nfunction normalizeHubSpotDate(value, fieldName) {\n  const timestamp = Number(value);\n  const date = new Date(timestamp);\n\n  if (!Number.isFinite(timestamp) || Number.isNaN(date.getTime())) {\n    throw new Error(\n      `Invalid date value for ${fieldName}: ${value}`\n    );\n  }\n\n  return date.toISOString().slice(0, 10);\n}\n\nconst offboardingReasonLabels = {\n  migration_to_another_provider:\n    \"Migration to another provider\",\n  budget_constraints:\n    \"Budget constraints\",\n  product_or_service_limitations:\n    \"Product or service limitations\",\n  business_closure_or_strategic_change:\n    \"Business closure or strategic change\",\n  other:\n    \"Other\",\n};\n\nconst companyId = String(company.companyId).trim();\nconst companyName = String(company.companyName).trim();\n\nconst customerTier = String(company.customerTier)\n  .trim()\n  .toLowerCase();\n\nconst customerStatus = String(company.customerStatus)\n  .trim()\n  .toLowerCase();\n\nconst dataExportRequired = normalizeBoolean(\n  company.dataExportRequired,\n  \"dataExportRequired\"\n);\n\nconst financeReviewRequired = normalizeBoolean(\n  company.financeReviewRequired,\n  \"financeReviewRequired\"\n);\n\nconst offboardingEligible =\n  customerStatus === \"offboarding in progress\";\n\nlet offboardingDate = null;\nlet offboardingReason = null;\nlet offboardingReasonLabel = null;\n\nif (offboardingEligible) {\n  const requiredOffboardingFields = [\n    \"offboardingDate\",\n    \"offboardingReason\",\n  ];\n\n  const missingOffboardingFields =\n    requiredOffboardingFields.filter((field) => {\n      const value = company[field];\n\n      return (\n        value === undefined ||\n        value === null ||\n        value === \"\"\n      );\n    });\n\n  if (missingOffboardingFields.length > 0) {\n    throw new Error(\n      `Missing required offboarding fields: ${missingOffboardingFields.join(\", \")}`\n    );\n  }\n\n  offboardingDate = normalizeHubSpotDate(\n    company.offboardingDate,\n    \"offboardingDate\"\n  );\n\n  offboardingReason = String(company.offboardingReason)\n    .trim()\n    .toLowerCase();\n\n  offboardingReasonLabel =\n    offboardingReasonLabels[offboardingReason];\n\n  if (!offboardingReasonLabel) {\n    throw new Error(\n      `Invalid offboarding reason: ${company.offboardingReason}`\n    );\n  }\n}\n\nconst enterpriseCustomer =\n  customerTier === \"enterprise\";\n\nconst manualReviewRequired =\n  enterpriseCustomer ||\n  dataExportRequired ||\n  financeReviewRequired;\n\nconst requiredOffboardingSteps = [];\n\nif (offboardingEligible) {\n  requiredOffboardingSteps.push(\n    \"Billing review\",\n    \"Account access review\",\n    \"Open support issues review\"\n  );\n\n  if (enterpriseCustomer) {\n    requiredOffboardingSteps.push(\n      \"Enterprise review\"\n    );\n  }\n\n  if (dataExportRequired) {\n    requiredOffboardingSteps.push(\n      \"Data export\"\n    );\n  }\n\n  if (financeReviewRequired) {\n    requiredOffboardingSteps.push(\n      \"Finance review\"\n    );\n  }\n}\n\nconst ticketDescription = offboardingEligible\n  ? [\n      `Offboarding date: ${offboardingDate}`,\n      `Reason: ${offboardingReasonLabel}`,\n      \"\",\n      \"Required offboarding steps:\",\n      ...requiredOffboardingSteps.map(\n        (step) => `• ${step}`\n      ),\n    ].join(\"\\n\")\n  : null;\n\nreturn {\n  json: {\n    companyId,\n    companyName,\n    customerTier,\n    customerStatus,\n    offboardingDate,\n    offboardingReason,\n    offboardingReasonLabel,\n    offboardingEligible,\n    eligibilityReason: offboardingEligible\n      ? null\n      : \"Customer status is not Offboarding in Progress\",\n    idempotencyKey: `offboarding:${companyId}`,\n    requiredOffboardingSteps,\n    ticketDescription,\n    rules: {\n      enterpriseCustomer,\n      dataExportRequired,\n      financeReviewRequired,\n      manualReviewRequired,\n    },\n    metadata: {\n      schemaVersion: \"1.1\",\n      processedAt: new Date().toISOString(),\n    },\n  },\n};"
      },
